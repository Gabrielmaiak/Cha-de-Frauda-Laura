<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chá de Fralda da Laura</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--b1:#fff6fa;--b2:#f5eeff;--tx:#4a3340;--mut:#a58a98;--pk:#f4a6c3;--pk2:#e0709c;--li:#c9b3f5;--card:rgba(255,255,255,.78);--bd:rgba(224,112,156,.22);--sh:0 10px 28px rgba(224,112,156,.14);--script:"Great Vibes","Brush Script MT",cursive;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--b1:#1d1422;--b2:#251a2e;--tx:#fbeaf3;--mut:#bfa3b4;--card:rgba(58,40,66,.72);--bd:rgba(244,166,195,.22);--sh:0 10px 28px rgba(0,0,0,.35)}}
:root[data-theme="dark"]{--b1:#1d1422;--b2:#251a2e;--tx:#fbeaf3;--mut:#bfa3b4;--card:rgba(58,40,66,.72);--bd:rgba(244,166,195,.22);--sh:0 10px 28px rgba(0,0,0,.35)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{margin:0;color:var(--tx);font-family:"Quicksand",system-ui,-apple-system,"Segoe UI",sans-serif;font-weight:500;background:linear-gradient(180deg,var(--b1),var(--b2) 50%,var(--b1));background-attachment:fixed;overflow-x:hidden}
#fly{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.bf{position:absolute;bottom:-60px;left:var(--x);width:var(--s);animation:up var(--t) linear infinite;animation-delay:var(--dl);opacity:.85}
.bf svg{width:100%;display:block;animation:sw 4s ease-in-out infinite alternate}
.bf .w{animation:fl .5s ease-in-out infinite alternate;transform-origin:32px 32px}
@keyframes up{to{transform:translateY(-125vh)}}
@keyframes sw{from{transform:translateX(-26px) rotate(-12deg)}to{transform:translateX(26px) rotate(12deg)}}
@keyframes fl{to{transform:scaleX(.35)}}
.hero,main,.who{position:relative;z-index:1}
.hero{max-width:720px;margin:auto;padding:38px 18px 8px;text-align:center}
.crown{font-size:46px;display:inline-block;animation:flo 3.6s ease-in-out infinite;filter:drop-shadow(0 6px 6px rgba(224,112,156,.35))}
@keyframes flo{50%{transform:translateY(-8px) rotate(-4deg)}}
.kick{margin:6px 0 0;font-size:13px;font-weight:700;letter-spacing:.35em;text-transform:uppercase;color:var(--pk2)}
h1{margin:0;font-family:var(--script);font-weight:400;font-size:clamp(88px,28vw,150px);line-height:1;background:linear-gradient(120deg,var(--pk2),var(--li),var(--pk2));background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shn 6s linear infinite;filter:drop-shadow(0 4px 10px rgba(224,112,156,.25))}
@keyframes shn{to{background-position:200% 0}}
.lead{margin:0 auto;max-width:400px;font-size:17px;color:var(--mut);line-height:1.5;animation:in 1s .2s both}
@keyframes in{from{opacity:0;transform:translateY(14px)}}
.info{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:20px;animation:in 1s .4s both}
.info span{background:var(--card);backdrop-filter:blur(10px);border:1px solid var(--bd);border-radius:24px;padding:9px 16px;font-size:14px;font-weight:700;box-shadow:var(--sh)}
.dv{text-align:center;color:var(--pk2);letter-spacing:.5em;margin:26px 0 4px;font-size:15px}
main{max-width:720px;margin:auto;padding:0 16px}
.step{text-align:center;font-size:13px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--mut);margin:6px 0}
h2{margin:30px 0 14px;font-family:var(--script);font-weight:400;font-size:42px;text-align:center;color:var(--pk2);line-height:1}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(min-width:600px){.grid{grid-template-columns:repeat(3,1fr)}}
.tile{position:relative;border:1.5px solid var(--bd);border-radius:26px;background:var(--card);backdrop-filter:blur(12px);color:var(--tx);box-shadow:var(--sh);padding:16px 12px 14px;text-align:center;cursor:pointer;font:inherit;font-weight:700;opacity:0;translate:0 24px;transition:transform .3s,box-shadow .3s,border-color .3s,background .3s}
.tile.in{opacity:1;translate:0 0;transition:transform .3s,box-shadow .3s,border-color .3s,background .3s,opacity .7s,translate .7s cubic-bezier(.2,1.2,.4,1)}
.tile:hover{transform:translateY(-4px)}
.pic{width:78px;height:78px;margin:0 auto 8px;border-radius:50%;background:radial-gradient(circle at 32% 28%,#fff,var(--c1) 55%,var(--c2));display:flex;align-items:center;justify-content:center;font-size:40px;box-shadow:inset 0 -6px 12px rgba(0,0,0,.06),0 8px 14px -6px var(--c2)}
.pic span{filter:drop-shadow(0 4px 3px rgba(0,0,0,.18));animation:flo 4s ease-in-out infinite;animation-delay:var(--d)}
.tile b{display:block;font-size:15px;line-height:1.2}
.tile small{display:block;color:var(--mut);font-size:12px;margin-top:3px;font-weight:500}
.tile .tg{position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:linear-gradient(120deg,var(--pk2),var(--li));color:#fff;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:12px;padding:3px 10px;white-space:nowrap}
.tile .ck{position:absolute;right:-6px;top:-10px;font-size:30px;transform:scale(0) rotate(-60deg);transition:transform .5s cubic-bezier(.3,1.9,.5,1);filter:drop-shadow(0 4px 4px rgba(224,112,156,.4))}
.tile.on{border-color:var(--pk2);background:linear-gradient(160deg,var(--card),rgba(244,166,195,.28));box-shadow:0 0 0 4px rgba(244,166,195,.3),var(--sh)}
.tile.on .ck{transform:scale(1) rotate(12deg)}
.who{max-width:720px;margin:20px auto 0;padding:0 16px 70px}
.card{border:1.5px solid var(--bd);border-radius:30px;background:var(--card);backdrop-filter:blur(14px);box-shadow:var(--sh);padding:26px 20px;text-align:center}
.card h3{margin:0;font-family:var(--script);font-weight:400;font-size:40px;color:var(--pk2);line-height:1.1}
.sel{margin:12px 0 10px;display:flex;flex-wrap:wrap;gap:6px;justify-content:center;font-size:13px;font-weight:700;color:var(--mut)}
.sel span{background:rgba(244,166,195,.25);color:var(--tx);border-radius:20px;padding:5px 12px;animation:pp .4s cubic-bezier(.3,1.8,.5,1)}
@keyframes pp{from{transform:scale(0)}}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.card input,.card textarea{width:100%;border:1.5px solid var(--bd);border-radius:18px;padding:14px 16px;font:inherit;font-weight:700;font-size:16px;background:rgba(255,255,255,.6);color:#4a3340;margin-top:10px;outline:none;transition:box-shadow .3s,border-color .3s}
.card input:focus,.card textarea:focus{border-color:var(--pk2);box-shadow:0 0 0 4px rgba(244,166,195,.3)}
.card textarea{resize:none;height:84px}
.err{border-color:#e0245e!important;animation:sk .35s}
@keyframes sk{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.go{position:relative;overflow:hidden;width:100%;margin-top:18px;border:0;border-radius:22px;background:linear-gradient(120deg,var(--pk2),var(--li));color:#fff;font:inherit;font-weight:700;font-size:17px;padding:16px;cursor:pointer;box-shadow:0 10px 22px rgba(224,112,156,.35);transition:transform .2s}
.go:active{transform:scale(.96)}
.go::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);animation:sh 3s infinite}
@keyframes sh{60%,100%{left:130%}}
.msg{font-size:13px;font-weight:700;margin-top:8px;min-height:18px;color:var(--pk2)}
.done{position:fixed;inset:0;z-index:9;background:linear-gradient(160deg,#ffd9e8,#e5d6ff);color:#4a3340;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px}
.done.show{display:flex;animation:rv .7s}
@keyframes rv{from{clip-path:circle(0% at 50% 85%)}to{clip-path:circle(150% at 50% 85%)}}
.done .big{font-size:96px;animation:flo 2.4s ease-in-out infinite}
.done h4{font-family:var(--script);font-weight:400;font-size:52px;margin:6px 0;color:#c4558a}
.done p{max-width:340px;line-height:1.55;margin:6px 0}.done .ev{margin-top:12px;background:rgba(255,255,255,.65);border-radius:18px;padding:12px 16px;font-weight:700;font-size:14px;max-width:340px;line-height:1.5}.done .fm{font-family:var(--script);font-size:30px;color:#c4558a;line-height:1.1;margin-top:14px}.done .nt{margin-top:10px;font-size:12px;opacity:.7;max-width:300px}
.done button{margin-top:18px;border:0;border-radius:20px;background:#fff;color:#c4558a;font:inherit;font-weight:700;padding:12px 26px;cursor:pointer;box-shadow:0 8px 18px rgba(196,85,138,.25)}
.cf{position:fixed;z-index:10;pointer-events:none;font-size:22px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.tile{opacity:1;translate:0 0}#fly{display:none}}
</style>
</head>
<body>
<div id="fly"></div>
<header class="hero">
  <div class="crown">👑</div>
  <p class="kick">Chá de fralda</p>
  <h1 id="nm"></h1>
  <p class="lead">Uma princesinha está chegando 🦋<br>Escolha com carinho o que você vai levar.</p>
  <div class="info"><span id="d"></span><span id="h"></span><span id="l"></span></div>
</header>
<div class="dv">✦ 🦋 ✦</div>
<main>
  <div class="step">Passo 1 · Escolha seu presente</div>
  <div id="main"></div>
</main>
<section class="who" id="who">
  <div class="dv">✦ 🦋 ✦</div>
  <div class="step">Passo 2 · Seu nome</div>
  <div class="card">
    <h3>Quem vai trazer o carinho?</h3>
    <div class="sel" id="sel"></div>
    <div class="two"><input id="n1" placeholder="Nome" autocomplete="given-name"><input id="n2" placeholder="Sobrenome" autocomplete="family-name"></div>
    <textarea id="rc" placeholder="Um recadinho para a Laura (opcional) 💌"></textarea>
    <button class="go" id="send">Confirmar presença 🦋</button>
    <div class="msg" id="msg"></div>
  </div>
</section>
<div class="done" id="done"><div class="big">🦋</div><h4 id="dt"></h4><p id="dp"></p><div class="ev" id="ev"></div><p class="fm">Com carinho,<br>família da Laura 💕</p><small class="nt">Se o WhatsApp não abriu, volte e toque em confirmar de novo.</small><button id="back">Voltar</button></div>
<script>
// ===== EDITE AQUI =====
var CFG={nome:"Laura",data:"📅 12/12/2026",hora:"",local:"📍 Rua Maria da Conceição de Melo, 163 - Ernesto Nascimento, BH",whats:"5531972269786"};
var ITEMS=[
["Fralda RN","👶","Recém-nascido","Fraldas","Mais pedida"],
["Fralda P","🍼","Até 6 kg","Fraldas"],["Fralda M","🍼","6 a 9,5 kg","Fraldas","Mais pedida"],
["Fralda G","🍼","9 a 13 kg","Fraldas"],["Fralda XG","🍼","12 a 15 kg","Fraldas"],["Fralda XXG","🍼","Acima de 14 kg","Fraldas"],
["Fralda de pano","🧷","Kit com 6","Fraldas"],["Fralda de boca","🧣","Kit com 5","Fraldas"],
["Lenços umedecidos","🧻","Pacote grande","Higiene","Essencial"],["Pomada de assadura","🧴","Qualquer marca","Higiene","Essencial"],
["Algodão","☁️","Pacote","Higiene"],["Cotonete infantil","🪥","Pacote","Higiene"],["Álcool 70% e gaze","🩹","Kit","Higiene"],
["Sabonete líquido","🛁","Infantil","Banho"],["Shampoo","🫧","Sem lágrimas","Banho"],["Condicionador","🧴","Infantil","Banho"],
["Toalha com capuz","🧖","Felpuda","Banho"],["Banheira","🛁","Com suporte","Banho","Presentão"],["Hidratante","🧴","Pele sensível","Banho"],
["Mamadeira","🍼","Anticólica","Alimentação"],["Chupeta","🎀","Ortodôntica","Alimentação"],["Babador","👶","Kit com 3","Alimentação"],
["Pote de papinha","🥣","Kit","Alimentação"],["Esterilizador","♨️","Micro-ondas","Alimentação","Presentão"],
["Body manga curta","👕","Tam. RN, P ou M","Roupinhas"],["Body manga longa","👚","Tam. RN, P ou M","Roupinhas"],
["Macacão","🧸","Tam. P ou M","Roupinhas"],["Meias e luvinhas","🧦","Kit","Roupinhas"],["Touca e sapatinho","🧶","Kit","Roupinhas"],
["Manta","🛏️","Algodão ou soft","Quarto"],["Lençol de berço","🌙","Com elástico","Quarto"],["Cobertor","☁️","Soft","Quarto"],
["Móbile","🎠","Musical","Quarto"],["Babá eletrônica","📡","Com câmera","Quarto","Presentão"],["Naninha","🐰","Bichinho","Quarto"]
];
var COL={Fraldas:["#ffd6e5","#f4a6c3"],Higiene:["#d6e8ff","#9cc4f2"],Banho:["#d3f4ea","#8fdcc2"],Alimentação:["#ffecc9","#f5c978"],Roupinhas:["#e6dbff","#c3aaf2"],Quarto:["#dce2ff","#a9b6f2"]};
var CAT={Fraldas:"Fraldas",Higiene:"Higiene",Banho:"Hora do banho",Alimentação:"Alimentação",Roupinhas:"Roupinhas",Quarto:"Quartinho"};
// ======================
var sel={};
function $(i){return document.getElementById(i)}
$("d").textContent=CFG.data;$("h").textContent=CFG.hora;$("h").style.display=CFG.hora?"":"none";$("l").textContent=CFG.local;$("nm").textContent=CFG.nome;
// borboletas
var BC=[["#f4a6c3","#e0709c"],["#c9b3f5","#9b7fe0"],["#9cc4f2","#6ea4e6"],["#ffc9a8","#f09a6e"],["#f4a6c3","#c9b3f5"]];
for(var q=0;q<9;q++){
  var c=BC[q%BC.length],e=document.createElement("div");e.className="bf";
  e.style.cssText="--x:"+(4+q*11)+"%;--s:"+(26+(q%4)*10)+"px;--t:"+(16+q*2.3)+"s;--dl:-"+(q*2.7)+"s";
  e.innerHTML='<svg viewBox="0 0 64 64"><g class="w"><path d="M32 30C27 12 7 6 5 19c-2 12 11 17 27 11z" fill="'+c[0]+'"/><path d="M32 32C25 40 12 40 14 51c2 9 15 6 18-9z" fill="'+c[1]+'" opacity=".85"/><path d="M32 30C37 12 57 6 59 19c2 12-11 17-27 11z" fill="'+c[0]+'"/><path d="M32 32C39 40 52 40 50 51c-2 9-15 6-18-9z" fill="'+c[1]+'" opacity=".85"/></g><rect x="30.6" y="22" width="2.8" height="26" rx="1.4" fill="#6b4a5d"/></svg>';
  $("fly").appendChild(e);
}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}})},{threshold:.12});
var groups={};
ITEMS.forEach(function(it,i){(groups[it[3]]=groups[it[3]]||[]).push(i)});
Object.keys(groups).forEach(function(c){
  var h=document.createElement("h2");h.textContent=CAT[c];$("main").appendChild(h);
  var g=document.createElement("div");g.className="grid";$("main").appendChild(g);
  groups[c].forEach(function(i,j){
    var it=ITEMS[i],t=document.createElement("button");t.className="tile";
    t.style.transitionDelay=(j%3)*70+"ms";
    t.innerHTML=(it[4]?'<span class="tg">'+it[4]+'</span>':'')+'<div class="pic" style="--c1:'+COL[c][0]+';--c2:'+COL[c][1]+'"><span style="--d:'+(-(i%7)*.5)+'s">'+it[1]+'</span></div><b>'+it[0]+'</b><small>'+it[2]+'</small><span class="ck">🦋</span>';
    t.onclick=function(e){
      if(sel[i]){delete sel[i];t.classList.remove("on")}else{sel[i]=1;t.classList.add("on");burst(e.clientX,e.clientY)}
      list();
    };
    g.appendChild(t);io.observe(t);
  });
});
function names(){return Object.keys(sel).map(function(k){return ITEMS[k][0]})}
function list(){
  var s=$("sel");s.innerHTML="";var n=names();
  if(!n.length){s.textContent="Volte e toque nos presentes que você vai levar 🎀";return}
  n.forEach(function(x){var p=document.createElement("span");p.textContent=x;s.appendChild(p)});
}
function burst(x,y){
  if(matchMedia("(prefers-reduced-motion:reduce)").matches)return;
  var E=["🦋","✨","💖","🎀","👑","🦋"];
  for(var i=0;i<10;i++){
    var s=document.createElement("span");s.className="cf";s.textContent=E[i%E.length];s.style.left=x+"px";s.style.top=y+"px";document.body.appendChild(s);
    var a=Math.random()*6.28,d=50+Math.random()*90;
    s.animate([{transform:"translate(0,0) scale(.4)",opacity:1},{transform:"translate("+Math.cos(a)*d+"px,"+(Math.sin(a)*d-60)+"px) scale(1.2) rotate("+(Math.random()*120-60)+"deg)",opacity:0}],{duration:900+Math.random()*600,easing:"cubic-bezier(.2,.8,.3,1)"}).onfinish=(function(n){return function(){n.remove()}})(s);
  }
}
function bad(el){el.classList.remove("err");void el.offsetWidth;el.classList.add("err")}
$("send").onclick=function(e){
  var a=$("n1"),b=$("n2"),n=names(),m=$("msg");m.textContent="";
  if(!n.length){m.textContent="Escolha pelo menos um presente lá em cima 🎀";return}
  if(!a.value.trim()){bad(a);a.focus();return}
  if(!b.value.trim()){bad(b);b.focus();return}
  var full=a.value.trim()+" "+b.value.trim(),rc=$("rc").value.trim();
  var t="Oi! Aqui é "+full+". Vou levar para o chá de fralda da "+CFG.nome+":\n• "+n.join("\n• ")+(rc?"\n\nRecado: "+rc:"")+"\n💕";
  burst(e.clientX,e.clientY);
  window.open("https://wa.me/"+CFG.whats+"?text="+encodeURIComponent(t),"_blank");
  $("dt").textContent="Muito obrigado, "+a.value.trim()+"!";
  $("dp").textContent="Sua presença e o seu carinho vão deixar o dia da "+CFG.nome+" ainda mais especial. Estamos ansiosos para receber você!";
  $("ev").textContent=[CFG.data,CFG.hora,CFG.local].filter(Boolean).join("  •  ");
  $("done").classList.add("show");
  for(var i=0;i<6;i++)setTimeout(function(){burst(Math.random()*innerWidth,innerHeight*.6)},i*260);
};
$("back").onclick=function(){$("done").classList.remove("show")};
list();
</script>
</body>
</html>
